  "cards": [
    {
      "dot": "cyan",
      "title": "GitHub — the source of truth",
      "items": [
        "One repo in the Savills org holds the entire app.",
        "index.html is the app; config.js holds the project URL and publishable key.",
        "The publishable key is public on purpose — it identifies the project, it does not grant access.",
        "No secrets live here. The service_role key has never been committed."
      ]
    },
    {
      "dot": "emerald",
      "title": "Vercel — hosting and deploys",
      "items": [
        "Watches main. A push is the deployment; there is no build step.",
        "Serves two static files worldwide over HTTPS.",
        "Rollback is picking an earlier deployment.",
        "Hobby tier bars commercial use — this needs Pro."
      ]
    },
    {
      "dot": "violet",
      "title": "Supabase — data, auth and realtime",
      "items": [
        "Postgres in an EU region, chosen at creation and fixed thereafter.",
        "Nine tables: people, accounts, sites, devices, issues, comments, activity, reviews, outcomes.",
        "Auth issues a JWT carrying the signed-in email address.",
        "Realtime streams row changes so every open browser stays in step."
      ]
    },
    {
      "dot": "amber",
      "title": "Why a public page is safe",
      "items": [
        "Anyone can read the source and take the key; it gets them nothing.",
        "Every table denies by default, then allows only a verified @savills.ie address.",
        "Verified from outside: anonymous reads return empty, anonymous writes are refused.",
        "Account names live in the database, never in the page."
      ]
    },
    {
      "dot": "slate",
      "title": "What is deliberately absent",
      "items": [
        "No server of ours. The browser talks to Postgres directly.",
        "No build pipeline, no node_modules, no framework.",
        "No password reset yet — email is throttled until SMTP is configured.",
        "Still on personal-tier accounts: the open governance question."
      ]
    }
  ]
